# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# If local MongoDB is not running, backend will automatically fall back to an embedded in-memory MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/jobconnect-ai

# Security & Authentication
JWT_SECRET=jobconnect_super_secret_jwt_key_998877_dev_production
JWT_EXPIRES_IN=7d

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# AI Service Configuration (Optional)
# If left empty, JobConnect AI uses its built-in deterministic weighted matching algorithm
GEMINI_API_KEY=
OPENAI_API_KEY=
